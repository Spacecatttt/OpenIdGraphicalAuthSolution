@model OrganizationsModel


@if (Model.Organizations != null && Model.Organizations.Any())
{
    @foreach (var org in Model.Organizations)
    {
        <tr class="hover:bg-gray-50 dark:hover:bg-[var(--accent-active)]">
            <td class="table-cell whitespace-nowrap text-sm font-medium text-text-primary">@org.Name</td>
            <td class="table-cell whitespace-nowrap text-sm text-text-secondary">@org.CreatedDate.ToString("yyyy-MM-dd HH:mm")
            </td>
            <td class="table-cell whitespace-nowrap text-sm text-blue-500">
                <a href="/@org.Slug" target="_blank" rel="noopener noreferrer" class="hover:underline">@org.Slug</a>
            </td>
            <td class="table-cell whitespace-nowrap text-sm text-text-secondary">
            </td>
            <td class="table-cell whitespace-nowrap text-sm font-medium">
                <form method="post" class="flex space-x-2">
                    <button type="submit" asp-page-handler="Groups" asp-route-id="@org.Id"
                        class="btn-secondary-blue px-3 py-1 text-xs">Groups</button>
                    <button type="submit" asp-page-handler="Users" asp-route-id="@org.Id"
                        class="btn-secondary-blue px-3 py-1 text-xs">Users</button>
                    <a asp-page="/Organizations/Edit" asp-route-id="@org.Id" class="btn-secondary px-3 py-1 text-xs">Edit</a>
                    <button type="submit" asp-page-handler="Delete" asp-route-id="@org.Id"
                        onclick="return confirm('Are you sure you want to delete this organization?');"
                        class="bg-red-500 hover:bg-red-600 text-white px-3 py-1 text-xs rounded-md">Delete</button>
                </form>
            </td>
        </tr>
    }
}
else
{
    <tr>
        <td colspan="5" class="table-cell text-center text-text-secondary py-8">No organizations found.</td>
    </tr>
}