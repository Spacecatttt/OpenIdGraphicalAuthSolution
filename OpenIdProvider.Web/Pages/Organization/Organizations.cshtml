@page "/Organizations"
@model OrganizationsModel
@{
    ViewData["Title"] = "Organizations";
}

<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/organizations.css" />
<style>
    .input-field {
        background-color: var(--bg-color);
        border: 1px solid var(--text-secondary);
        color: var(--text-primary);
        border-radius: 0.375rem;
        padding: 0.5rem 0.75rem;
    }
</style>

<div class="w-full flex flex-col items-center">
    <div class="w-full max-w container-custom rounded-lg shadow-lg p-6">
        <div class="flex flex-col md:flex-row justify-between items-center mb-6">
            <h1 class="text-lg font-semibold text-text-primary m-0 p-0">Organizations</h1>
            <form method="post" asp-page-handler="Add" class="m-0">
                <button type="submit" class="btn-primary flex items-center space-x-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd"
                            d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z"
                            clip-rule="evenodd" />
                    </svg>
                    <span>Add</span>
                </button>
            </form>
        </div>

        <form method="get" id="filterForm">
            <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-700">
                <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                    <thead class="table-header">
                        <tr>
                            <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider">
                                <div class="flex items-center space-x-1">
                                    <span>Name</span>
                                    <input asp-for="NameSearch" class="input-field w-30 text-xs" type="text"
                                        placeholder="Search..." />
                                    <img src="/images/filter.png" alt="Filter Icon"
                                        class="h-4 w-4 text-text-secondary cursor-pointer" />
                                </div>
                            </th>
                            <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider">
                                <div class="flex items-center space-x-1">
                                    <span>Created time</span>
                                    <button type="submit" name="SortOrder" value="@Model.NextSortOrder"
                                        class="p-1 rounded hover:bg-gray-200 dark:hover:bg-gray-600">
                                        @if (Model.SortOrder == "date_asc")
                                        {
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M5 15l7-7 7 7"></path>
                                            </svg>
                                        }
                                        else if (Model.SortOrder == "date_desc")
                                        {
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M19 9l-7 7-7-7"></path>
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor"
                                                viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M8 9l4-4 4 4m0 6l-4 4-4-4"></path>
                                            </svg>
                                        }
                                    </button>
                                </div>
                            </th>
                            <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider">
                                <div class="flex items-center space-x-1">
                                    <span>Slug</span>
                                    <input asp-for="SlugSearch" type="text" placeholder="Search..."
                                        class="input-field w-30 text-xs" />
                                    <img src="/images/filter.png" alt="Filter Icon"
                                        class="h-4 w-4 text-text-secondary cursor-pointer" />
                                </div>
                            </th>
                            <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider">
                            </th>
                            <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider">
                                <div class="flex space-x-2">
                                    <button type="submit" class="btn-primary w-full text-xs py-1">Search</button>
                                    <button type="button" class="btn-secondary w-full text-xs py-1"
                                        onclick="clearSearch()">Clear</button>
                                </div>
                            </th>
                        </tr>
                    </thead>
                    <tbody id="organizationsTableBody"
                        class="divide-y divide-gray-200 dark:divide-gray-700 dark:bg-secondary-bg bg-[var(--secondary-bg)]">
                        <partial name="_OrganizationsTable" model="Model" />
                    </tbody>
                </table>
            </div>

            <div class="flex justify-between items-center mt-6 text-text-secondary">
                <div>
                    <span>@Model.TotalOrganizations in total</span>
                </div>
                <input type="hidden" asp-for="CurrentPage" id="currentPageInput" />
                <div class="flex items-center space-x-2">
                    <button type="button" onclick="changePage(@(Model.CurrentPage - 1))"
                        class="btn-secondary px-3 py-1 rounded-md" @(Model.CurrentPage <= 1 ? "disabled" : "")>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                            stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                        </svg>
                    </button>

                    <span>@Model.CurrentPage / @Model.TotalPages</span>

                    <button type="button" onclick="changePage(@(Model.CurrentPage + 1))"
                        class="btn-secondary px-3 py-1 rounded-md" @(Model.CurrentPage >= Model.TotalPages ? "disabled"
                                                                                           : "")>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                            stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                    </button>

                    <select asp-for="NumberItemsPageSize" class="input-field text-sm"
                        onchange="document.getElementById('filterForm').submit();">
                        <option value="10">10 / page</option>
                        <option value="20">20 / page</option>
                        <option value="50">50 / page</option>
                    </select>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('filterForm');
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                updateTable();
            });
        });

        function changePage(pageNumber) {
            document.getElementById('currentPageInput').value = pageNumber;
            updateTable();
        }

        async function clearSearch() {
            document.querySelector('input[name="SlugSearch"]').value = '';
            document.querySelector('input[name="NameSearch"]').value = '';
            updateTable()
        }

        async function updateTable() {
            const form = document.getElementById('filterForm');
            const formData = new FormData(form);
            const params = new URLSearchParams(formData);

            const response = await fetch(`/Organizations?handler=TableData&${params.toString()}`);
            const html = await response.text();

            document.getElementById('organizationsTableBody').innerHTML = html;

            // Тут можна також оновити номери сторінок, якщо потрібно,
            // але це вимагатиме повертати з сервера JSON з даними, а не просто HTML.
            // Для простоти поки оновлюємо тільки таблицю.
        }
    </script>
}