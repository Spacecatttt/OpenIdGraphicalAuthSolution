@model UserNavViewModel

<select name="selectedOrganizationId" id="organization-selector" class="form-select org-selector">
    @foreach (var org in Model.UserOrganizations)
    {
        <option value="@org.Slug" selected="@(org.Slug == Model.SelectedOrganizationSlug ? "selected" : null)">
            @org.Name
        </option>
    }
</select>

<a href="#" class="icon-btn" id="theme-toggle" title="Toggle theme">☀️</a>

<div class="profile-container">
    <div class="profile" id="profile-trigger">
        <img src="@Model.UserAvatarUrl" alt="@Model.UserName" />
        <span>@Model.UserName</span>

    </div>

    <div class="profile-dropdown" id="profile-dropdown-menu">
        <a href="@Url.Page("/Account/Manage")">Settings</a>
        <form asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
            <button type="submit" class="dropdown-item-button">Logout</button>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const profileTrigger = document.getElementById('profile-trigger');
        const dropdownMenu = document.getElementById('profile-dropdown-menu');

        if (profileTrigger && dropdownMenu) {
            profileTrigger.addEventListener('click', function (event) {
                event.stopPropagation();
                dropdownMenu.classList.toggle('show');
            });

            document.addEventListener('click', function (event) {
                if (!profileTrigger.contains(event.target) && !dropdownMenu.contains(event.target)) {
                    dropdownMenu.classList.remove('show');
                }
            });
        }
    });

    document.getElementById('organization-selector').addEventListener('change', function () {
        const selectedOrgSlug = this.value;
        const currentUrl = new URL(window.location.href);

        currentUrl.searchParams.set('orgSlug', selectedOrgSlug);
        window.location.href = currentUrl.href;
    });
</script>
