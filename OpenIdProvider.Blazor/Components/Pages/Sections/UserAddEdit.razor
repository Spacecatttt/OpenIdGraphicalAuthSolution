@page "/users/add"
@page "/users/edit/{UserId:guid}"
@attribute [Authorize(Policy = "IsManager")]
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using System.Text
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using Duende.IdentityServer.EntityFramework.Entities
@using OpenIdProvider.Data
@using OpenIdProvider.Data.Models
@using OpenIdProvider.Blazor.Services

@using SixLabors.ImageSharp
@using SixLabors.ImageSharp.PixelFormats
@using SixLabors.ImageSharp.Formats.Png

@inject ILogger<UserAddEdit> Logger
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject IDbContextFactory<Duende.IdentityServer.EntityFramework.DbContexts.ConfigurationDbContext> ConfigurationDbContextFactory
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@inject AppState AppState
@inject IHelperService HelperService


<PageTitle>User</PageTitle>

@if (isLoading)
{
    <div class="status-container">
        <p class="status-message"><em>Loading...</em></p>
    </div>
}
else if (AppState.SelectedOrganization == null)
{
    <div class="form-container">
        <p class="error-message">An organization must be selected to manage users.</p>
    </div>
}
else if (!CanManageUsers)
{
    <div class="form-container">
        <p class="error-message">You do not have permission to manage users in this organization.</p>
    </div>
}
else
{
    <div class="form-container">
        <div class="form-header">
            <h1>@(IsNew ? "Add New User to " + AppState.SelectedOrganization.Name : "Edit User")</h1>
            <button class="btn btn-secondary" @onclick="NavigateBack">
                <img src="/images/table/back.png" alt="Back" class="btn-icon" />
                <span>Back to Users</span>
            </button>
        </div>

        <EditForm Model="userModel" OnValidSubmit="HandleSave">
            <DataAnnotationsValidator />
            <div class="form-grid">

                <h2 class="form-section-header">Basic Information</h2>
                <div class="form-group">
                    <label for="displayName">Display Name<span class="required-asterisk">*</span></label>
                    <InputText id="displayName" @bind-Value="userModel.DisplayName" class="form-input" />
                    <ValidationMessage For="@(() => userModel.DisplayName)" />
                </div>
                <div class="form-group">
                    <label for="username">Username<span class="required-asterisk">*</span></label>
                    <InputText id="username" @bind-Value="userModel.UserName" class="form-input" />
                    <ValidationMessage For="@(() => userModel.UserName)" />
                </div>
                <div class="form-group">
                    <label for="email">Email<span class="required-asterisk">*</span></label>
                    <InputText id="email" @bind-Value="userModel.Email" class="form-input" disabled="@(!IsNew)" />
                    <ValidationMessage For="@(() => userModel.Email)" />
                </div>
                <div class="form-group">
                    <label for="avatarUrl">Avatar URL</label>
                    <InputText id="avatarUrl" @bind-Value="userModel.AvatarUrl" class="form-input" />
                </div>

                <h2 class="form-section-header">Authentication</h2>
                <div class="form-group">
                    <label for="authType">Authentication Type</label>
                    <InputSelect TValue="AuthMethod" @bind-Value="userModel.AuthType" class="form-input">
                        <option value="@AuthMethod.Password">Password</option>
                        <option value="@AuthMethod.Graphical">Graphical</option>
                    </InputSelect>
                </div>

                @if (userModel.AuthType == AuthMethod.Password)
                {
                    @if(IsNew)
                    {
                        <div class="form-group">
                            <label for="password">Password<span class="required-asterisk">*</span></label>
                            <div class="password-input-wrapper">
                                <InputText id="password" @bind-Value="userModel.Password" type="@passwordFieldType" class="form-input"/>
                                <div class="password-buttons">
                                    <button type="button" class="password-btn" title="Generate Password"
                                        @onclick="() => userModel.Password = HelperService.GeneratePassword(16)">
                                        <img src="/images/security/generate_password.png" alt="Generate" />
                                    </button>

                                    <button type="button" class="password-btn" @onclick="TogglePasswordVisibility">
                                        <img src="@(passwordFieldType == "password" ?
                                            "/images/security/eye_show.png" :
                                            "/images/security/eye_hide.png")" alt="Show/Hide" />
                                    </button>
                                </div>
                            </div>
                            <ValidationMessage For="@(() => userModel.Password)" />
                        </div>
                    }
                    else
                    {
                        <h2 class="form-section-header">Change Password</h2>
                        <div class="form-group">
                            <label for="newPassword">New Password (optional)</label>
                            <div class="password-input-wrapper">
                                <InputText id="newPassword" @bind-Value="userModel.NewPassword" type="@passwordFieldType" class="form-input" />
                                <div class="password-buttons">
                                    <button type="button" class="password-btn" title="Generate Password" @onclick="() => userModel.NewPassword = HelperService.GeneratePassword(16)">
                                        <img src="/images/security/generate_password.png" alt="Generate" />
                                    </button>
                                    <button type="button" class="password-btn" @onclick="TogglePasswordVisibility">
                                        <img src="@(passwordFieldType == "password" ? "/images/security/eye_show.png" : "/images/security/eye_hide.png")" alt="Show/Hide" />
                                    </button>
                                </div>
                            </div>
                            <ValidationMessage For="@(() => userModel.NewPassword)" />
                        </div>
                        <div class="form-group">
                            <label for="confirmPassword">Confirm New Password</label>
                             <div class="password-input-wrapper">
                                <InputText id="confirmPassword" @bind-Value="userModel.ConfirmPassword" type="@passwordFieldType" class="form-input" />
                            </div>
                            <ValidationMessage For="@(() => userModel.ConfirmPassword)" />
                        </div>
                    }

                }

                @if (userModel.AuthType == AuthMethod.Graphical)
                {
                    <div class="form-group">
                        <p class="upload-instruction">Please upload a .png image that will be used as the user's graphical password.</p>
                        <div class="file-drop-zone">
                            <InputFile OnChange="HandleGraphicalFileSelected" accept=".png" class="file-drop-zone-input-overlay" />
                            <span class="file-drop-zone-text">
                                @if (!string.IsNullOrEmpty(graphicalPasswordStatusMessage)) { @graphicalPasswordStatusMessage; }
                                else { @("Select or drop file here"); }
                            </span>
                        </div>
                    </div>
                    <div class="form-group">
                        <button type="button" class="btn btn-primary" @onclick="HandleEmbedGraphicalPassword" disabled="@(graphicalPasswordModel.BaseImageFile == null)">
                            Generate & Embed Secure Password
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(graphicalPasswordModel.ResultImageDataUrl))
                    {
                        <div class="result-container mt-3">
                            <p><strong>Success!</strong> Provide this image to the user. They will need it to log in.</p>
                            <img src="@graphicalPasswordModel.ResultImageDataUrl"
                                class="result-image" alt="Image with embedded secret" />
                            <a href="@graphicalPasswordModel.ResultImageDataUrl" download="@downloadFileName"
                                class="btn btn-primary d-block mt-2">
                                Download Image
                            </a>
                        </div>
                    }
                }

                <h2 class="form-section-header">Additional Information</h2>
                <div class="form-group">
                    <label for="country">Country/Region</label>
                    <InputText id="country" @bind-Value="userModel.Country" class="form-input" />
                </div>
                <div class="form-group">
                    <label for="location">Location</label>
                    <InputText id="location" @bind-Value="userModel.Location" class="form-input" />
                </div>
                <div class="form-group">
                    <label for="address">Address</label>
                    <InputText id="address" @bind-Value="userModel.Address" class="form-input" />
                </div>
                <div class="form-group">
                    <label for="bio">Bio</label>
                    <InputTextArea id="bio" @bind-Value="userModel.Bio" class="form-textarea" rows="3" />
                </div>

                <h2 class="form-section-header">Assignments</h2>
                <div class="form-group">
                    <label for="role">Role in Organization</label>
                    <InputSelect @bind-Value="userModel.Role" TValue="OrganizationRole" class="form-input">
                        @foreach (var role in Enum.GetValues<OrganizationRole>()
                                                  .Cast<OrganizationRole>()
                                                  .Where(r => r <= AppState.CurrentUserRoleInSelectedOrg))
                        {
                            <option value="@role">@role.ToString()</option>
                        }
                    </InputSelect>
                </div>

                <div class="form-group">
                    <label>Groups</label>
                    <div class="multi-select-wrapper">
                        <div class="multi-select-container" @onclick="() => isGroupDropdownOpen = !isGroupDropdownOpen">
                            @if (!GetSelectedGroups().Any())
                            {
                                <span class="multi-select-placeholder">Select a group to add...</span>
                            }
                            @foreach (var selectedGroup in GetSelectedGroups())
                            {
                                <div class="selected-item">
                                    <span>@selectedGroup.Name</span>
                                    <button type="button" class="remove-item-btn" @onclick="() => RemoveGroup(selectedGroup.Id)" @onclick:stopPropagation>&times;</button>
                                </div>
                            }
                        </div>

                        @if (isGroupDropdownOpen)
                        {
                            <ul class="multi-select-dropdown">
                                @foreach (var group in availableGroups)
                                {
                                    <li @onclick="() => SelectGroup(group.Id)">@group.Name</li>
                                }
                                @if (!availableGroups.Any())
                                {
                                    <li class="disabled">No more groups to add</li>
                                }
                            </ul>
                        }
                    </div>
                </div>

                <div class="form-group">
                    <label>Signup Clients</label>
                    <div class="multi-select-wrapper">
                        <div class="multi-select-container" @onclick="() => isClientDropdownOpen = !isClientDropdownOpen">
                            @if (!GetSelectedClients().Any())
                            {
                                <span class="multi-select-placeholder">Select a client to add...</span>
                            }
                            @foreach (var selectedClient in GetSelectedClients())
                            {
                                <div class="selected-item">
                                    <span>@selectedClient.ClientName</span>
                                    <button type="button" class="remove-item-btn" @onclick="() => RemoveClient(selectedClient.Id)" @onclick:stopPropagation>&times;</button>
                                </div>
                            }
                        </div>

                        @if (isClientDropdownOpen)
                        {
                            <ul class="multi-select-dropdown">
                                @foreach (var client in availableClients)
                                {
                                    <li @onclick="() => SelectClient(client.Id)">@client.ClientName</li>
                                }
                                @if (!availableClients.Any())
                                {
                                    <li class="disabled">No more clients to add</li>
                                }
                            </ul>
                        }
                    </div>
                </div>

            </div>
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="error-message">@errorMessage</div>
            }
            <div class="form-footer">
                <button type="submit" class="btn btn-primary" disabled="@isSaving">
                    @if(isSaving) { <span class="spinner-border spinner-border-sm"></span>; }
                    else { @(IsNew ? "Add User" : "Save Changes"); }
                </button>
                <button type="button" class="btn btn-secondary" @onclick="NavigateBack">Cancel</button>
            </div>
        </EditForm>
    </div>
}
@code {
    #region Parameters & State
    [Parameter]
    public Guid? UserId { get; set; }
    private bool IsNew => UserId == null;

    //
    private bool isLoading = true;
    private bool isSaving;
    private string? errorMessage;
    private UserViewModel userModel = new();
    private bool CanManageUsers => AppState.CurrentUserRoleInSelectedOrg >= OrganizationRole.Admin;
    private string passwordFieldType = "password";

    // State for graphical password
    private GraphicalPasswordViewModel graphicalPasswordModel = new();
    private string? graphicalPasswordStatusMessage;
    const long maxFileSize = 10 * 1024 * 1024; // 10 MB
    private string downloadFileName => $"{userModel.UserName}-password.png";

    // Data for dropdowns
    private List<Group> allGroupsInOrg = new();
    private List<Group> availableGroups => allGroupsInOrg.Where(g => !userModel.SelectedGroupIds.Contains(g.Id)).ToList();
    private List<Client> allClientsInOrg = new();
    private List<Client> availableClients => allClientsInOrg.Where(c => !userModel.SelectedClientIds.Contains(c.Id)).ToList();

    private bool isGroupDropdownOpen = false;
    private bool isClientDropdownOpen = false;
    #endregion

    #region Lifecycle & Data Loading
    protected override async Task OnInitializedAsync()
    {
        if (!CanManageUsers || AppState.SelectedOrganization == null)
        {
            isLoading = false;
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        allGroupsInOrg = await dbContext.Groups
            .Where(g => g.OrganizationId == AppState.SelectedOrganization.Id)
            .AsNoTracking().ToListAsync();

        var clientIdsForOrg = await dbContext.ClientOwnerships
            .Where(co => co.OrganizationId == AppState.SelectedOrganization.Id)
            .Select(co => co.ClientId)
            .ToListAsync();

        await using var configDbContext = await ConfigurationDbContextFactory.CreateDbContextAsync();

        allClientsInOrg = await configDbContext.Clients
            .Where(c => clientIdsForOrg.Contains(c.Id))
            .AsNoTracking().ToListAsync();

        if (IsNew)
        {
            // Generate UserViewModel with predefined values
            userModel = await GenerateDataAsync();
        }
        else
        {
            var user = await dbContext.Users
                .Include(u => u.Groups)
                .Include(u => u.AllowedClientPermissions)
                .AsNoTracking()
                .FirstOrDefaultAsync(u => u.Id == UserId);

            var userRole = await dbContext.UserOrganizationRoles
                .AsNoTracking()
                .FirstOrDefaultAsync(uor => uor.UserId == UserId && uor.OrganizationId == AppState.SelectedOrganization.Id);

            if (user != null && userRole != null)
            {
                if (AppState.CurrentUserRoleInSelectedOrg < userRole.Role)
                {
                    errorMessage = "You cannot edit a user with a higher role than your own.";
                    userModel = new();
                    isLoading = false;
                    return;
                }

                userModel = new UserViewModel
                {
                    DisplayName = user.DisplayName!,
                    UserName = user.UserName!,
                    Email = user.Email!,
                    AvatarUrl = user.AvatarUrl,
                    Role = userRole.Role,
                    SelectedGroupIds = user.Groups.Select(g => g.Id).ToList(),
                    SelectedClientIds = user.AllowedClientPermissions.Select(p => p.ClientId).ToList(),
                    Country = user.Country,
                    Location = user.Location,
                    Address = user.Address,
                    Bio = user.Bio,
                    AuthType = string.IsNullOrEmpty(user.GraphicalAuthMethodType) ? AuthMethod.Password : AuthMethod.Graphical
                };
            }
            else { errorMessage = "User not found in the selected organization."; }
        }
        isLoading = false;
    }
    private async Task<UserViewModel> GenerateDataAsync()
    {
        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        string newUserName;

        while (true)
        {
            var randomSuffix = HelperService.GenerateRandomString(8);
            newUserName = $"user-{randomSuffix}";

            var userExists = await dbContext.Users.AnyAsync(u => u.UserName == newUserName);
            if (!userExists)
            {
                break;
            }
        }

        return new UserViewModel
        {
            Role = OrganizationRole.Member,
            UserName = newUserName,
            Password = HelperService.GeneratePassword(16)
        };
    }
   #endregion

    #region Event Handlers & Navigation
    private async Task HandleSave()
    {
        if (AppState.SelectedOrganization == null) { errorMessage = "An organization must be selected."; return; }
        errorMessage = null;
        isSaving = true;

        if (IsNew && userModel.AuthType == AuthMethod.Password && string.IsNullOrWhiteSpace(userModel.Password))
        {
            errorMessage = "Password is required for a new user with password authentication.";
            isSaving = false;
            return;
        }
        if (IsNew && userModel.AuthType == AuthMethod.Graphical && string.IsNullOrWhiteSpace(userModel.GraphicalPasswordKey))
        {
            errorMessage = "A graphical password must be set up before creating the user.";
            isSaving = false;
            return;
        }

        if (AppState.CurrentUserRoleInSelectedOrg < OrganizationRole.Admin && userModel.Role == OrganizationRole.Owner)
        {
            errorMessage = "You cannot assign the Owner role.";
            isSaving = false;
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        await using var transaction = await dbContext.Database.BeginTransactionAsync();

        try
        {
            if (IsNew)
            {
                Guid? primaryOrgId = null;
                if (userModel.Role >= OrganizationRole.Viewer)
                {
                    // Create a personal organization for the new user
                    var personalOrg = new Organization
                    {
                        Name = $"{userModel.UserName}'s Personal Space",
                        Slug = $"{userModel.UserName}-personal-space",
                        CreatedDate = DateTime.UtcNow,
                        ModifiedDate = DateTime.UtcNow
                    };
                    dbContext.Organizations.Add(personalOrg);
                    await dbContext.SaveChangesAsync();
                    primaryOrgId = personalOrg.Id;
                }

                // Create new user and set their PrimaryOrganizationId
                // For 'Member' role, primaryOrgId remains null.
                var newUser = new ApplicationUser
                {
                    UserName = userModel.UserName,
                    Email = userModel.Email,
                    DisplayName = userModel.DisplayName,
                    AvatarUrl = userModel.AvatarUrl,
                    Country = userModel.Country,
                    Location = userModel.Location,
                    Address = userModel.Address,
                    Bio = userModel.Bio,
                    GraphicalPasswordKey = userModel.GraphicalPasswordKey,
                    GraphicalAuthMethodType = userModel.AuthType == AuthMethod.Graphical ? "ImageSteganography" : null,
                    PrimaryOrganizationId = primaryOrgId
                };
                var result = await UserManager.CreateAsync(newUser, userModel.Password);

                if (!result.Succeeded)
                {
                    throw new Exception(string.Join(", ", result.Errors.Select(e => e.Description)));
                }

                dbContext.UserOrganizationRoles.Add(new UserOrganizationRole
                    {
                        UserId = newUser.Id,
                        OrganizationId = AppState.SelectedOrganization.Id,
                        Role = userModel.Role
                    }
                );

                // Assign groups
                var selectedGroups = await dbContext.Groups.Where(g => userModel.SelectedGroupIds.Contains(g.Id)).ToListAsync();
                foreach (var group in selectedGroups)
                {
                    newUser.Groups.Add(group);
                }
                // Assign clients
                foreach(var clientId in userModel.SelectedClientIds)
                {
                    newUser.AllowedClientPermissions.Add(new UserClientPermission { ClientId = clientId });
                }
            }
            else
            {
                // Firstly update password
                if (!string.IsNullOrWhiteSpace(userModel.NewPassword))
                {
                    var userForPasswordReset = await UserManager.FindByIdAsync(UserId.ToString()!);

                    if (userForPasswordReset == null)
                        throw new Exception("Could not find the user to update password.");

                    var token = await UserManager.GeneratePasswordResetTokenAsync(userForPasswordReset);
                    var result = await UserManager.ResetPasswordAsync(userForPasswordReset, token, userModel.NewPassword);
                    if (!result.Succeeded)
                    {
                        throw new Exception(string.Join(", ", result.Errors.Select(e => e.Description)));
                    }
                }

                var userToUpdate = await dbContext.Users
                        .Include(u => u.Groups)
                        .Include(u => u.AllowedClientPermissions)
                        .FirstOrDefaultAsync(u => u.Id == UserId);

                var userRoleToUpdate = await dbContext.UserOrganizationRoles
                    .FirstOrDefaultAsync(uor => uor.UserId == UserId &&
                                                uor.OrganizationId == AppState.SelectedOrganization.Id);

                if (userToUpdate == null || userRoleToUpdate == null)
                {
                    throw new Exception("Could not find the user to update.");
                }

                userToUpdate.DisplayName = userModel.DisplayName;
                userToUpdate.UserName = userModel.UserName;
                userToUpdate.AvatarUrl = userModel.AvatarUrl;
                userToUpdate.Country = userModel.Country;
                userToUpdate.Location = userModel.Location;
                userToUpdate.Address = userModel.Address;
                userToUpdate.Bio = userModel.Bio;
                userToUpdate.GraphicalPasswordKey = userModel.GraphicalPasswordKey;
                userToUpdate.GraphicalAuthMethodType = userModel.AuthType == AuthMethod.Graphical ?
                                                                "ImageSteganography"
                                                                : null;
                userRoleToUpdate.Role = userModel.Role;

                // Groups
                var selectedGroups = await dbContext.Groups.Where(g => userModel.SelectedGroupIds.Contains(g.Id)).ToListAsync();
                userToUpdate.Groups.SyncCollection(selectedGroups, g => g.Id, g => g.Id, g => g);
                // Clients
                userToUpdate.AllowedClientPermissions.SyncCollection(
                    userModel.SelectedClientIds,
                    p => p.ClientId,
                    id => id,
                    id => new UserClientPermission { ClientId = id, UserId = userToUpdate.Id }
                );
            }

            await dbContext.SaveChangesAsync();
            await transaction.CommitAsync();
            NavigateBack();
        }
        catch (Exception ex)
        {
            await transaction.RollbackAsync();
            Logger.LogError(ex, "An error occurred while saving the user.");
            errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private IEnumerable<Group> GetSelectedGroups() =>
        allGroupsInOrg.Where(g => userModel.SelectedGroupIds.Contains(g.Id));
    private void SelectGroup(Guid groupId)
    {
        if (!userModel.SelectedGroupIds.Contains(groupId))
        {
            userModel.SelectedGroupIds.Add(groupId);
        }
        isGroupDropdownOpen = false;
    }
    private void RemoveGroup(Guid groupId) => userModel.SelectedGroupIds.Remove(groupId);

    private IEnumerable<Client> GetSelectedClients() =>
        allClientsInOrg.Where(c => userModel.SelectedClientIds.Contains(c.Id));
    private void SelectClient(int clientId)
    {
        if (clientId != 0 &&!userModel.SelectedClientIds.Contains(clientId))
        {
            userModel.SelectedClientIds.Add(clientId);
        }
        isClientDropdownOpen = false;
    }
    private void RemoveClient(int clientId) => userModel.SelectedClientIds.Remove(clientId);

    private void NavigateBack() => NavigationManager.NavigateTo("/users");
    #endregion

    #region Password Event Handlers
    private void TogglePasswordVisibility()
    {
        passwordFieldType = passwordFieldType == "password" ? "text" : "password";
    }
    private void HandleGraphicalFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.GetMultipleFiles(1).FirstOrDefault();
        graphicalPasswordModel.ResultImageDataUrl = null;

        if (file == null)
        {
            graphicalPasswordStatusMessage = null;
            graphicalPasswordModel.BaseImageFile = null;
            return;
        }

        if (file.ContentType != "image/png")
        {
            graphicalPasswordStatusMessage = "Error: Only .png files are allowed.";
            graphicalPasswordModel.BaseImageFile = null;
        }
        else if (file.Size > maxFileSize)
        {
            graphicalPasswordStatusMessage = $"Error: File size cannot exceed {maxFileSize / 1024 / 1024} MB.";
            graphicalPasswordModel.BaseImageFile = null;
        }
        else
        {
            graphicalPasswordModel.BaseImageFile = file;
            graphicalPasswordStatusMessage = $"File selected: {file.Name}";
        }
    }
    private async Task HandleEmbedGraphicalPassword()
    {
        if (graphicalPasswordModel.BaseImageFile == null)
        {
            graphicalPasswordStatusMessage = "Please select an image first.";
            return;
        }

        graphicalPasswordStatusMessage = "Processing...";
        try
        {
            var password = HelperService.GeneratePassword(16);
            var key = HelperService.GenerateRandomString(32);

            await using var imageStream = new MemoryStream();
            await graphicalPasswordModel.BaseImageFile.OpenReadStream(maxFileSize).CopyToAsync(imageStream);
            imageStream.Position = 0;
            using var originalImage = Image.Load<Rgba32>(imageStream);
            using var stegoImage = ImageSteganographyUtility.EmbedText(originalImage, password, key);

            // Store credentials in the main view model to be saved with the user
            if (IsNew)
            {
                userModel.Password = password;
            }
            else
            {
                userModel.NewPassword = password;
                userModel.ConfirmPassword = password;
            }
            userModel.GraphicalPasswordKey = key;

            await using var outputStream = new MemoryStream();
            var encoder = new PngEncoder {
                ColorType = PngColorType.RgbWithAlpha,
                CompressionLevel = PngCompressionLevel.DefaultCompression
            };
            await stegoImage.SaveAsync(outputStream, encoder);
            var base64 = Convert.ToBase64String(outputStream.ToArray());
            graphicalPasswordModel.ResultImageDataUrl = $"data:image/png;base64,{base64}";
            graphicalPasswordStatusMessage = "Graphical password ready. Save the user to apply changes.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error embedding graphical password.");
            graphicalPasswordStatusMessage = $"Error: {ex.Message}";
        }
    }
    #endregion

    #region View Models
    public class UserViewModel
    {
        [Required]
        public string DisplayName { get; set; } = string.Empty;
        [Required]
        public string UserName { get; set; } = string.Empty;
        [Required, EmailAddress]
        public string Email { get; set; } = string.Empty;
        public string? AvatarUrl { get; set; }
        public string Password { get; set; } = string.Empty;

        // Empty string or a string between 6 and 100 characters long
        [RegularExpression(@"^$|^.{6,100}$", ErrorMessage = "The password must be between 6 and 100 characters long.")]
        [DataType(DataType.Password)]
        public string? NewPassword { get; set; }

        [DataType(DataType.Password)]
        [Compare("NewPassword", ErrorMessage = "The new password and confirmation password do not match.")]
        public string? ConfirmPassword { get; set; }

        public string? GraphicalPasswordKey { get; set; }
        public OrganizationRole Role { get; set; } = OrganizationRole.Viewer;
        public AuthMethod AuthType { get; set; } = AuthMethod.Password;
        public string? Country { get; set; }
        public string? Location { get; set; }
        public string? Address { get; set; }
        public string? Bio { get; set; }
