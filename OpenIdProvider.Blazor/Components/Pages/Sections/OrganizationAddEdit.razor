@page "/organizations/add"
@page "/organizations/edit/{Id:guid}"
@attribute [Authorize(Policy = "IsManager")]
@rendermode InteractiveServer

@using Duende.IdentityServer.EntityFramework.Entities
@using Microsoft.EntityFrameworkCore
@using System.ComponentModel.DataAnnotations
@using System.Text.RegularExpressions
@using OpenIdProvider.Data
@using OpenIdProvider.Data.Models
@using OpenIdProvider.Blazor.Services

@inject ILogger<OrganizationAddEdit> Logger
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject IDbContextFactory<Duende.IdentityServer.EntityFramework.DbContexts.ConfigurationDbContext> ConfigurationDbContextFactory
@inject NavigationManager NavigationManager
@inject AppState AppState

<PageTitle>Organization</PageTitle>

@if (isLoading)
{
    <div class="status-container">
        <p class="status-message"><em>Loading...</em></p>
    </div>
}
else
{
    <div class="form-container">
        <div class="form-header">
            <h1>@(IsNew ? "Create New Organization" : "Edit Organization")</h1>
            <button class="btn btn-secondary flex" @onclick="NavigateBack">
                <img src="/images/table/back.png" alt="Add" class="btn-icon" />
                <span>Back to List</span>
            </button>
        </div>

        <EditForm Model="organizationViewModel" OnValidSubmit="HandleSave">
            <DataAnnotationsValidator />

            <div class="form-grid">

                <div class="form-group">
                    <label for="name">Organization Name<span class="required-asterisk">*</span></label>
                    <InputText id="name" @bind-Value="organizationViewModel.Name" @oninput="GenerateSlugFromName"
                               class="form-input" />
                    <ValidationMessage For="@(() => organizationViewModel.Name)" />
                </div>
                <div class="form-group">
                    <label for="slug">Slug (URL)<span class="required-asterisk">*</span></label>
                    <InputText id="slug" @bind-Value="organizationViewModel.Slug" @oninput="() => slugManuallyEdited = true"
                               class="form-input" />
                    <ValidationMessage For="@(() => organizationViewModel.Slug)" />
                </div>
                <div class="form-group full-width">
                    <label for="description">Description</label>
                    <InputTextArea id="description" @bind-Value="organizationViewModel.Description" class="form-textarea"
                                   rows="4" />
                </div>
                <div class="form-group-checkbox full-width">
                    <InputCheckbox id="isActive" @bind-Value="organizationViewModel.IsActive" />
                    <label for="isActive">Organization is Active</label>
                </div>

                <h2 class="form-section-header">Client Permissions</h2>
                <div class="form-group-checkbox">
                    <InputCheckbox @bind-Value="allowAllManagerClients" id="allowAllClients" />
                    <label for="allowAllClients">Allow assigning any client you manage</label>
                </div>

                <div class="form-group">
                    <div class="form-label-group">
                        <label>Allowed Clients</label>
                        <small class="text-muted">Select which clients all users in this organization can access</small>
                    </div>
                    <div class="multi-select-wrapper">
                        <div class="multi-select-container" @onclick="() => isClientDropdownOpen = !isClientDropdownOpen">
                            @if (!GetSelectedClients().Any())
                            {
                                <span class="multi-select-placeholder">Select a client to allow...</span>
                            }
                            @foreach (var selectedClient in GetSelectedClients())
                            {
                                <div class="selected-item">
                                    <span>@selectedClient.ClientName</span>
                                    <button type="button" class="remove-item-btn" @onclick="() => RemoveClient(selectedClient.Id)" @onclick:stopPropagation>&times;</button>
                                </div>
                            }
                        </div>

                        @if (isClientDropdownOpen)
                        {
                            <ul class="multi-select-dropdown">
                                @foreach (var client in availableClients)
                                {
                                    <li @onclick="() => SelectClient(client.Id)">@client.ClientName (@client.ClientId)</li>
                                }
                                @if (!availableClients.Any())
                                {
                                    <li class="disabled">No other clients available to add</li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="error-message">
                    @errorMessage
                </div>
            }

            <div class="form-footer">
                <button type="submit" class="btn btn-primary">@(IsNew ? "Create Organization" : "Save Changes")</button>
                <button type="button" class="btn btn-secondary" @onclick="NavigateBack">Cancel</button>
            </div>
        </EditForm>
    </div>
}


@code {
    #region Parameters & State
    [Parameter]
    public Guid? Id { get; set; }
    private OrganizationViewModel organizationViewModel = new();
    private bool isLoading = true;
    private bool IsNew => Id == null;
    private bool slugManuallyEdited = false;
    private string? errorMessage;

    // State for client permissions
    private bool isClientDropdownOpen = false;
    private List<int> clientIdsForThisOrg = new();
    private List<Client> allManageableClients = new();
    private List<Client> clientViewList = new();

    private List<Client> availableClients => clientViewList.Where(c => !organizationViewModel.SelectedClientIds.Contains(c.Id)).ToList();
    private bool _allowAllManagerClients;
    private bool allowAllManagerClients
    {
        get => _allowAllManagerClients;
        set
        {
            _allowAllManagerClients = value;
            UpdateClientSourceList();
            // Clearing selected items that are no longer available
            organizationViewModel.SelectedClientIds = organizationViewModel.SelectedClientIds
                .Intersect(clientViewList.Select(c => c.Id))
                .ToList();
        }
    }
    #endregion

    #region Lifecycle & Data Loading
    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        await using var dbContext = await DbContextFactory.CreateDbContextAsync();

        var managedOrgIds = AppState.UserOrganizations.Select(o => o.Id).ToList();
        var allClientOwnerships = await dbContext.ClientOwnerships
            .Where(co => managedOrgIds.Contains(co.OrganizationId))
            .AsNoTracking()
            .ToListAsync();

        var manageableClientIds = allClientOwnerships
            .Select(co => co.ClientId)
            .Distinct().ToList();

        await using var configDbContext = await ConfigurationDbContextFactory.CreateDbContextAsync();
        allManageableClients = await configDbContext.Clients
            .Where(c => manageableClientIds.Contains(c.Id))
            .AsNoTracking()
            .ToListAsync();

        if (IsNew)
        {
            organizationViewModel = new OrganizationViewModel { IsActive = true };
            slugManuallyEdited = false;
        }
        else
        {
            var dbOrganization = await dbContext.Organizations
                .AsNoTracking()
                .FirstOrDefaultAsync(o => o.Id == Id);

            if (dbOrganization != null)
            {

                organizationViewModel = new OrganizationViewModel
                {
                    Name = dbOrganization.Name,
                    Slug = dbOrganization.Slug,
                    Description = dbOrganization.Description,
                    IsActive = dbOrganization.IsActive,
                    SelectedClientIds = await dbContext.OrganizationClientPermissions
                        .Where(ocp => ocp.OrganizationId == dbOrganization.Id)
                        .Select(ocp => ocp.ClientId)
                        .ToListAsync()
                };

                slugManuallyEdited = true;

                clientIdsForThisOrg = allClientOwnerships
                    .Where(co => co.OrganizationId == Id)
                    .Select(co => co.ClientId)
                    .Distinct()
                    .ToList();
            }
            else
            {
                Logger.LogError("Organization with ID {Id} not found.", Id);
                NavigateBack();
                return;
            }
        }
        UpdateClientSourceList();
        isLoading = false;
    }

    private void GenerateSlugFromName(ChangeEventArgs e)
    {
        if (!slugManuallyEdited)
        {
            var name = e.Value?.ToString() ?? "";
            var slug = name.ToLower().Trim();
            slug = Regex.Replace(slug, @"\s+", "-");
            slug = Regex.Replace(slug, @"[^a-z0-9-]", "");
            organizationViewModel.Slug = slug;
        }
    }
    #endregion

    #region Event Handlers & Navigation
    private async Task HandleSave()
    {
        errorMessage = null;
        if (AppState.CurrentUser == null)
        {
            errorMessage = "Error: User is not authenticated.";
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var slugExists = await dbContext.Organizations
            .AnyAsync(o => o.Slug == organizationViewModel.Slug && o.Id != Id);

        if (slugExists)
        {
            errorMessage = $"Error: The slug '{organizationViewModel.Slug}' is already in use. Please choose a different one.";
            return;
        }

        try
        {
            if (IsNew)
            {

                var newOrganization = new Organization
                {
                    Name = organizationViewModel.Name,
                    Slug = organizationViewModel.Slug,
                    Description = organizationViewModel.Description,
                    IsActive = organizationViewModel.IsActive,
                    CreatedDate = DateTime.UtcNow,
                    ModifiedDate = DateTime.UtcNow
                };
                dbContext.Organizations.Add(newOrganization);

                var userRole = new UserOrganizationRole
                {
                    UserId = AppState.CurrentUser.Id,
                    Organization = newOrganization, // Link to the new entity
                    Role = OrganizationRole.Owner
                };
                dbContext.UserOrganizationRoles.Add(userRole);

                foreach (var clientId in organizationViewModel.SelectedClientIds)
                {
                    dbContext.OrganizationClientPermissions.Add(new OrganizationClientPermission
                    {
                        Organization = newOrganization,
                        ClientId = clientId
                    });
                }
                Logger.LogInformation("Creating new organization '{Name}' ...", organizationViewModel.Name);
            }
            else
            {
                var orgToUpdate = await dbContext.Organizations
                    .Include(o => o.AllowedClientPermissions)
                    .FirstOrDefaultAsync(o => o.Id == Id);

                if (orgToUpdate == null)
                {
                    errorMessage = "Error: The organization you are trying to edit no longer exists.";
                    return;
                }

                // Update scalar properties from the ViewModel
                dbContext.Entry(orgToUpdate).CurrentValues.SetValues(organizationViewModel);
                orgToUpdate.ModifiedDate = DateTime.UtcNow;

                orgToUpdate.AllowedClientPermissions.SyncCollection(
                    organizationViewModel.SelectedClientIds,
                    permission => permission.ClientId,
                    id => id,
                    id => new OrganizationClientPermission { ClientId = id }
                );
                Logger.LogInformation("Updating organization {Id} ...", orgToUpdate.Id);
            }

            await dbContext.SaveChangesAsync();
            await AppState.InitializeAsync(true);
            NavigateBack();
        }
        catch (DbUpdateException ex)
        {
            Logger.LogError(ex, "An error occurred while saving the organization.");
            errorMessage = "A database error occurred.";
        }
    }

    private void UpdateClientSourceList()
    {
        if (allowAllManagerClients)
        {
            clientViewList = allManageableClients;
        }
        else if (IsNew)
        {
            clientViewList = new();
        }
        else
        {
            clientViewList = allManageableClients
                .Where(c => clientIdsForThisOrg.Contains(c.Id))
                .ToList();
        }
    }
    private IEnumerable<Client> GetSelectedClients() =>
        allManageableClients.Where(c => organizationViewModel.SelectedClientIds.Contains(c.Id));
    private void SelectClient(int clientId)
    {
        if (!organizationViewModel.SelectedClientIds.Contains(clientId))
        {
            organizationViewModel.SelectedClientIds.Add(clientId);
        }
        isClientDropdownOpen = false;
    }
    private void RemoveClient(int clientId) => organizationViewModel.SelectedClientIds.Remove(clientId);

    private void NavigateBack()
    {
        NavigationManager.NavigateTo("/organizations");
    }
    #endregion

    public class OrganizationViewModel
    {
        [Required]
        [StringLength(256)]
        public string Name { get; set; } = string.Empty;

        [Required]
        [StringLength(100)]
        public string Slug { get; set; } = string.Empty;

        public string? Description { get; set; }

        public bool IsActive { get; set; } = true;

        public List<int> SelectedClientIds { get; set; } = new();
    }
}
