@page "/users"
@attribute [Authorize]
@implements IDisposable
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using OpenIdProvider.Data
@using OpenIdProvider.Data.Models
@using OpenIdProvider.Blazor.Services

@inject ILogger<Users> Logger
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject NavigationManager NavigationManager
@inject AppState AppState
@inject IJSRuntime JSRuntime


<PageTitle>Users for @(AppState.SelectedOrganization?.Name ?? "Selected Organization")</PageTitle>

@if (isLoading)
{
    <p><em>Loading...</em></p>
}
else if (AppState.SelectedOrganization == null)
{
    <div class="page-container">
        <div class="page-header">
             <h1>Users</h1>
        </div>
        <p class="info-message">Please select an organization from the navigation bar to view its users.</p>
    </div>
}
else
{
    <div class="page-container">
        <div class="page-header">
            <h1>Users in @AppState.SelectedOrganization.Name</h1>
            <button type="button" @onclick="GoToAddPage" class="btn btn-primary">
                <img src="/images/table/add.png" alt="Add User" class="btn-icon" />
                <span>Add User</span>
            </button>
        </div>

        <div class="table-wrapper">
            <table class="org-table">
                <thead>
                    <tr>
                        <th>
                            <div class="filter-controls">
                                <span>Display Name</span>
                                <input @bind="nameSearch" @bind:event="oninput" class="filter-input" type="text" placeholder="Search..." />
                            </div>
                        </th>
                        <th>
                            <div class="filter-controls">
                                <span>Email</span>
                                <input @bind="emailSearch" @bind:event="oninput" class="filter-input" type="text" placeholder="Search..." />
                            </div>
                        </th>
                        <th>Role</th>
                        <th>Joined Date</th>
                        <th colspan="2">
                            <div class="filter-controls">
                                <button type="button" @onclick="ClearFilters" class="btn btn-secondary w-full text-xs py-2 ml-auto">Clear</button>
                            </div>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in users)
                    {
                        <tr>
                            <td>
                                <div class="user-cell">
                                    <img src="@(user.User.AvatarUrl ?? $"https://placehold.co/32x32/8A42D8/FFFFFF?text={user.User.DisplayName.Substring(0, 1).ToUpper()}")" class="user-avatar" />
                                    <span>@user.User.DisplayName</span>
                                </div>
                            </td>
                            <td class="text-sm text-text-secondary">@user.User.Email</td>
                            <td class="text-sm text-text-secondary">@user.Role</td>
                            <td class="text-sm text-text-secondary">@user.AddedDate.ToString("yyyy-MM-dd")</td>
                            <td colspan="2">
                                <div class="action-btn-group">
                                    <button @onclick='() => GoToEditPage(user.UserId)'
                                            class="action-btn btn-edit"
                                            disabled="@(!CanManageUsers)">Edit</button>
                                    <button @onclick='() => DeleteUser(user.UserId, user.User.DisplayName)'
                                            class="action-btn btn-delete"
                                            disabled="@(!CanManageUsers || AppState.CurrentUser?.Id == user.UserId)"
                                            title="@(AppState.CurrentUser?.Id == user.UserId ? "You cannot remove yourself" : "")">Delete</button>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!users.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-text-secondary py-8">No users found in this organization.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="page-footer">
            <div>
                <span>@totalUsers in total</span>
            </div>
            <div class="pagination-controls">
                <button type="button" @onclick="() => ChangePage(currentPage - 1)" disabled="@(currentPage <= 1)"
                    class="pagination-btn">
                    <img src="/images/table/arrow-right.png" alt="Previous" class="btn-icon flipped-horizontally" />
                </button>
                <span>@currentPage / @totalPages</span>
                <button type="button" @onclick="() => ChangePage(currentPage + 1)" disabled="@(currentPage >= totalPages)"
                    class="pagination-btn">
                    <img src="/images/table/arrow-right.png" alt="Next" class="btn-icon" />
                </button>
                <select @bind="pageSize" class="page-size-selector">
                    <option value="10">10 / page</option>
                    <option value="20">20 / page</option>
                    <option value="50">50 / page</option>
                </select>
            </div>
        </div>
    </div>
}

@code {
    #region Parameters & State
    private bool isLoading = true;
    private List<UserOrganizationRole> users = new();
    private List<UserOrganizationRole> allUsersForOrg = new();

    // State for pagination
    private int totalUsers;
    private int currentPage = 1;
    private int totalPages;
    private int _pageSize = 10;
    private int pageSize
    {
        get => _pageSize;
        set { if (_pageSize != value) { _pageSize = value; currentPage = 1; FilterUsers(); } }
    }

    // State for sorting
    private string? _nameSearch;
    private string? nameSearch { get => _nameSearch; set { _nameSearch = value; FilterUsers(); } }

    private string? _emailSearch;
    private string? emailSearch { get => _emailSearch; set { _emailSearch = value; FilterUsers(); } }

    // Section: Permissions
    private bool CanManageUsers => AppState.CurrentUserRoleInSelectedOrg >= OrganizationRole.Admin;
    #endregion

    #region Lifecycle & Data Loading
    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += HandleStateChange;
        await LoadUsersAsync();
    }
    private async void HandleStateChange()
    {
        await InvokeAsync(LoadUsersAsync);
    }
    private async Task LoadUsersAsync()
    {
        isLoading = true;
        StateHasChanged();

        if (AppState.SelectedOrganization == null)
        {
            allUsersForOrg.Clear();
        }
        else
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            var loadedRoles = await dbContext.UserOrganizationRoles
                .Include(uor => uor.User)
                .Where(uor => uor.OrganizationId == AppState.SelectedOrganization.Id)
                .AsNoTracking()
                .ToListAsync();

            var currentUser = AppState.CurrentUser;
            var selectedOrg = AppState.SelectedOrganization;

            if (currentUser != null
                && currentUser.PrimaryOrganizationId == selectedOrg.Id
                && !loadedRoles.Any(r => r.UserId == currentUser.Id))
            {
                loadedRoles.Add(new UserOrganizationRole
                {
                    User = currentUser,
                    UserId = currentUser.Id,
                    OrganizationId = selectedOrg.Id,
                    Role = OrganizationRole.Owner,
                    AddedDate = currentUser.PrimaryOrganization?.CreatedDate ?? DateTime.UtcNow
                });

            }

            allUsersForOrg = loadedRoles.OrderBy(uor => uor.User.DisplayName).ToList();
        }

        FilterUsers();
        isLoading = false;
        StateHasChanged();
    }
    #endregion

    #region Filtering & Pagination
    private void FilterUsers()
    {
        var query = allUsersForOrg.AsQueryable();
        if (!string.IsNullOrWhiteSpace(_nameSearch))
        {
            query = query.Where(uor =>
                uor.User.DisplayName != null && uor.User.DisplayName.Contains(_nameSearch, StringComparison.OrdinalIgnoreCase)
            );
        }
        if (!string.IsNullOrWhiteSpace(_emailSearch))
        {
            query = query.Where(uor =>
                uor.User.Email != null && uor.User.Email.Contains(_emailSearch, StringComparison.OrdinalIgnoreCase)
            );
        }
        var filteredList = query.ToList();

        totalUsers = filteredList.Count;
        totalPages = (int)Math.Ceiling(totalUsers / (double)pageSize);
        if (totalPages == 0) totalPages = 1;
        if (currentPage > totalPages) currentPage = totalPages;

        users = filteredList
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }
    private void ChangePage(int newPage)
    {
        if (newPage > 0 && newPage <= totalPages)
        {
            currentPage = newPage;
            FilterUsers();
        }
    }
    private void ClearFilters()
    {
        _nameSearch = string.Empty;
        _emailSearch = string.Empty;
    }
    #endregion

    #region Event Handlers & Navigation
    private void GoToAddPage()
    {
        if (!CanManageUsers) return;
        NavigationManager.NavigateTo("/users/add");
    }
    private void GoToEditPage(Guid userId)
    {
        if (!CanManageUsers) return;
        NavigationManager.NavigateTo($"/users/edit/{userId}");
    }
    private async Task DeleteUser(Guid userId, string userName)
    {
        if (!CanManageUsers) return;

        if (userId == AppState.CurrentUser?.Id)
        {
            await JSRuntime.InvokeVoidAsync("alert", "You cannot remove yourself from the organization.");
        }


        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to remove user '{userName}' from this organization?");
        if (confirmed && AppState.SelectedOrganization != null)
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            var userRoleToDelete = await dbContext.UserOrganizationRoles
                .FirstOrDefaultAsync(uor => uor.UserId == userId && uor.OrganizationId == AppState.SelectedOrganization.Id);

            if (userRoleToDelete != null)
            {
                dbContext.UserOrganizationRoles.Remove(userRoleToDelete);
                await dbContext.SaveChangesAsync();
                await LoadUsersAsync();
            }
        }
    }
    #endregion

    public void Dispose()
    {
        AppState.OnChange -= HandleStateChange;
    }
}
