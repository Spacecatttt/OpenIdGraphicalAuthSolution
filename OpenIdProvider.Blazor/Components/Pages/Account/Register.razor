@page "/account/register"
@layout DefaultLayout
@attribute [AllowAnonymous]
@attribute [StreamRendering]
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using System.Text.RegularExpressions
@using OpenIdProvider.Data.Models
@using OpenIdProvider.Blazor.Endpoints
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web

@inject HttpClient Http
@inject ILogger<Register> Logger

<PageTitle>Sign Up</PageTitle>

<div class="container-1">
    <div class="container-2">
        @if (currentStep == Step.UserDetails)
        {
            <EditForm EditContext="editContext" OnValidSubmit="() => { }">
                <h3>Sign up</h3>
                @if (!string.IsNullOrEmpty(generalErrorMessage))
                {
                    <div class="alert alert-danger">@generalErrorMessage</div>
                }
                <div class="form-floating mb-2">
                    <InputText @bind-Value="Input.User.UserName" class="form-control"
                        placeholder="Enter your username..." />
                    <label class="form-label">Username</label>
                    <ValidationMessage For="() => Input.User.UserName" class="text-danger" />
                </div>
                <div class="form-floating mb-2">
                    <InputText @bind-Value="Input.User.DisplayName" class="form-control"
                        placeholder="Enter your display name..." />
                    <label class="form-label">Visible name</label>
                    <ValidationMessage For="() => Input.User.DisplayName" class="text-danger" />
                </div>
                <div class="form-floating mb-2">
                    <InputText @bind-Value="Input.User.Email" type="email" class="form-control"
                        placeholder="Enter your email..." />
                    <label class="form-label">Email</label>
                    <ValidationMessage For="() => Input.User.Email" class="text-danger" />
                </div>
                <div class="form-floating mb-2">
                    <InputText @bind-Value="Input.User.Password" type="password" class="form-control"
                        placeholder="Enter your password..." />
                    <label class="form-label">Password</label>
                    <ValidationMessage For="() => Input.User.Password" class="text-danger" />
                </div>
                <div class="form-floating mb-2">
                    <InputText @bind-Value="Input.User.ConfirmPassword" type="password" class="form-control"
                        placeholder="Confirm your password..." />
                    <label class="form-label">Confirm Password</label>
                    <ValidationMessage For="() => Input.User.ConfirmPassword" class="text-danger" />
                </div>

                <button type="button" class="btn-success" @onclick="GoToOrganizationStep" disabled="@isProcessing">
                    @if (isProcessing)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {

                        @("Next step")
                    }
                </button>
            </EditForm>
        }
        else if (currentStep == Step.ConfirmUpgrade)
        {
            <h3>Activate Your Account</h3>
            <div class="alert alert-info">
                An account with the email <strong>@Input.User.Email</strong> already exists as an invited user.
                Do you want to activate it by creating your own primary organization?
            </div>

            <div class="d-flex">
                <button type="button" class="btn-back" @onclick="GoToUserStep">
                    Go Back
                </button>
                <button type="button" class="btn-success w-auto" @onclick="() => currentStep = Step.OrgDetails">
                    Yes, Create Organization
                </button>
            </div>
        }
        else if (currentStep == Step.OrgDetails)
        {
            <form method="post" action="/account/register">
                <AntiforgeryToken />
                <h3>Create Your First Organization</h3>

                @if (!string.IsNullOrEmpty(generalErrorMessage))
                {
                    <div class="alert alert-danger">@generalErrorMessage</div>
                }

                <input type="hidden" name="User.UserName" value="@Input.User.UserName" />
                <input type="hidden" name="User.DisplayName" value="@Input.User.DisplayName" />
                <input type="hidden" name="User.Email" value="@Input.User.Email" />
                <input type="hidden" name="User.Password" value="@Input.User.Password" />
                <input type="hidden" name="User.ConfirmPassword" value="@Input.User.ConfirmPassword" />

                <div class="form-floating mb-2">
                    <input name="Organization.Name" value="@Input.Organization.Name" @oninput="UpdateSlugFromName"
                        class="form-control" placeholder="Enter organization name..." />
                    <label class="form-label">Organization Name</label>
                </div>
                <div class="form-floating mb-2">
                    <textarea name="Organization.Description"
                        @onchange="(e) => Input.Organization.Description = e.Value?.ToString() ?? string.Empty"
                        class="form-control" placeholder="Enter description..."
                        style="height: 6rem;">@Input.Organization.Description</textarea>
                    <label class="form-label">Description</label>
                </div>
                <div class="form-floating mb-2">
                    <input name="Organization.Slug" value="@Input.Organization.Slug" @oninput="UpdateSlugManually"
                        class="form-control" placeholder="Enter slug..." />
                    <label class="form-label">Slug</label>
                </div>

                <button type="submit" class="btn-success">
                    Create Account & Organization
                </button>
            </form>

            <div class="container-inline">
                <p>Want to go back?</p>
                <button type="button" class="link-style-button" @onclick="GoToUserStep">
                    Back to user details
                </button>
            </div>
        }

        @if (currentStep == Step.UserDetails)
        {
            <div class="container-inline">
                <p>Already registered?</p>
                <a href="/account/login">Sign in</a>
            </div>
        }
    </div>
    <div class="container-3">
        <img src="/images/mountainsSignUp.png" alt="Mountains" />
    </div>
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? PostSubmitError { get; set; }

    private enum Step { UserDetails, ConfirmUpgrade, OrgDetails }
    private Step currentStep = Step.UserDetails;
    private bool isProcessing = false;
    private bool slugManuallyEdited = false;

    private string? generalErrorMessage;
    private EditContext editContext = default!;
    private ValidationMessageStore messageStore = default!;

    private RegistrationInputModel Input { get; set; } = new();

    protected override void OnInitialized()
    {
        editContext = new(Input);
        messageStore = new(editContext);

        if (!string.IsNullOrEmpty(PostSubmitError))
        {
            generalErrorMessage = PostSubmitError;
            currentStep = Step.OrgDetails;
        }
    }
    private void UpdateSlugFromName(ChangeEventArgs e)
    {
        Input.Organization.Name = e.Value?.ToString() ?? string.Empty;
        if (!slugManuallyEdited)
        {
            var name = Input.Organization.Name;
            var slug = name.ToLower().Trim().Replace(" ", "-");
            slug = Regex.Replace(slug, @"[^a-z0-9-]", "");
            Input.Organization.Slug = slug;
        }
    }
    private void UpdateSlugManually(ChangeEventArgs e)
    {
        slugManuallyEdited = true;
        Input.Organization.Slug = e.Value?.ToString() ?? string.Empty;
    }
    private async Task GoToOrganizationStep()
    {
        isProcessing = true;
        generalErrorMessage = null;
        messageStore.Clear();

        var validationContext = new ValidationContext(Input.User);
        var validationResults = new List<ValidationResult>();
        bool isUserStepValid = Validator.TryValidateObject(Input.User, validationContext,
        validationResults, validateAllProperties: true);

        if (!isUserStepValid)
        {
            foreach (var result in validationResults)
            {
                if (result.MemberNames.Any())
                {
                    var fieldIdentifier = new FieldIdentifier(Input.User, result.MemberNames.First());
                    messageStore.Add(fieldIdentifier, result.ErrorMessage ?? "Validation error");
                }
            }
            isProcessing = false;
            editContext.NotifyValidationStateChanged();
            return;
        }

        var response = await Http.PostAsJsonAsync("/account/validate-user-step", Input.User);
        if (response.IsSuccessStatusCode)
        {
            currentStep = Step.OrgDetails;
            var validationResult = await response.Content.ReadFromJsonAsync<UserValidationResponse>();
            if (validationResult is { CanProceed: true })
            {
                if (validationResult.IsExistingEndUser)
                {
                    currentStep = Step.ConfirmUpgrade;
                }
                else
                {
                    currentStep = Step.OrgDetails;
                }
            }
        }
        else
        {
            var problemDetails = await response.Content.ReadFromJsonAsync<ValidationProblemDetails>();
            if (problemDetails?.Errors != null)
            {
                foreach (var error in problemDetails.Errors)
                {
                    var fieldIdentifier = new FieldIdentifier(Input.User, error.Key);
                    messageStore.Add(fieldIdentifier, error.Value);
                }
            }
            else
            {
                generalErrorMessage = "An unknown validation error occurred.";
            }
        }
        isProcessing = false;
        editContext.NotifyValidationStateChanged();
    }
    private void GoToUserStep()
    {
        currentStep = Step.UserDetails;
        generalErrorMessage = null;
        slugManuallyEdited = false;
        messageStore.Clear();
        editContext.NotifyValidationStateChanged();
    }
}
