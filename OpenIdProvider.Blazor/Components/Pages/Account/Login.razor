@page "/account/login"
@layout DefaultLayout
@attribute [AllowAnonymous]

@using Duende.IdentityServer.EntityFramework.DbContexts
@using Duende.IdentityServer.Services
@using Microsoft.EntityFrameworkCore
@using OpenIdProvider.Data

@inject IIdentityServerInteractionService Interaction
@inject IDbContextFactory<ConfigurationDbContext> ConfigDbContextFactory
@inject IDbContextFactory<ApplicationDbContext> AppDbContextFactory

<PageTitle>Log in</PageTitle>

<LoginForm IsOidcFlow="@isOidcFlow" ClientId="@clientId" ReturnUrl="@ReturnUrl" ErrorMessage="@ErrorMessage"
    SignupEnabled="@signupEnabled" />

@code {
    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorMessage { get; set; }

    private bool isOidcFlow;
    private string? clientId;
    private bool signupEnabled = true; // Default to true for direct access

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(ReturnUrl))
        {
            // This must be called during the initial server render because it might modify HTTP headers.
            var context = await Interaction.GetAuthorizationContextAsync(ReturnUrl);
            if (context != null)
            {
                isOidcFlow = true;
                clientId = context.Client.ClientId;

                await using var configDbContext = await ConfigDbContextFactory.CreateDbContextAsync();
                var client = await configDbContext.Clients
                    .AsNoTracking()
                    .FirstOrDefaultAsync(c => c.ClientId == clientId);

                if (client != null)
                {
                    await using var appDbContext = await AppDbContextFactory.CreateDbContextAsync();
                    var ownership = await appDbContext.ClientOwnerships.AsNoTracking()
                    .FirstOrDefaultAsync(co => co.ClientId == client.Id);

                    signupEnabled = ownership?.EnableSignup ?? false;
                }
                else
                {
                    signupEnabled = false;
                }
            }
        }
    }
}
