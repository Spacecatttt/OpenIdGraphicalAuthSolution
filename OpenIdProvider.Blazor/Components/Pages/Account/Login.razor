@page "/account/login"
@layout DefaultLayout
@attribute [AllowAnonymous]

@using System.ComponentModel.DataAnnotations
@using OpenIdProvider.Data.Models
@using Microsoft.AspNetCore.Components.Forms
@using Duende.IdentityServer.Services

@inject IIdentityServerInteractionService Interaction

<LoginForm IsOidcFlow="@isOidcFlow" ClientId="@clientId" ReturnUrl="@ReturnUrl" ErrorMessage="@ErrorMessage" />

@code {
    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorMessage { get; set; }

    private bool isOidcFlow;
    private string? clientId;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(ReturnUrl))
        {
            // This must be called during the initial server render because it might modify HTTP headers.
            var context = await Interaction.GetAuthorizationContextAsync(ReturnUrl);
            if (context != null)
            {
                isOidcFlow = true;
                clientId = context.Client.ClientId;
            }
        }
    }
}
