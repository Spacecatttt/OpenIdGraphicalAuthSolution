@page "/Error"
@page "/home/error"
@layout DefaultLayout
@attribute [AllowAnonymous]

@using System.Diagnostics
@using Duende.IdentityServer.Models
@using Duende.IdentityServer.Services
@inject IIdentityServerInteractionService Interaction

<PageTitle>Error</PageTitle>

<style>
    .error-container {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        text-align: center;
        padding-top: 5rem;
    }
    .error-card {
        max-width: 600px;
        width: 100%;
    }
</style>

<div class="error-container">
    <div class="error-card">
        <h1 class="text-danger">Error</h1>

        @if (OidcError != null)
        {
            <div class="alert alert-danger">
                <p>An error occurred during the authentication process.</p>
            </div>

            <div class="card">
                <div class="card-header">
                    OIDC Error Details
                </div>
                <div class="card-body">
                    <h5 class="card-title text-danger">@OidcError.Error</h5>
                    @if (OidcError.ErrorDescription != null)
                    {
                        <p class="card-text">@OidcError.ErrorDescription</p>
                    }
                </div>
            </div>

            @if (OidcError.RedirectUri != null)
            {
                <div class="mt-3">
                    <a class="btn btn-secondary" href="@OidcError.RedirectUri">
                        Return to Client Application
                    </a>
                </div>
            }
        }
        else
        {
            <h2 class="text-danger">An error occurred while processing your request.</h2>
            @if (ShowRequestId)
            {
                <p>
                    <strong>Request ID:</strong> <code>@RequestId</code>
                </p>
            }
        }
    </div>
</div>


@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);
    private ErrorMessage? OidcError { get; set; }

    protected override async Task OnInitializedAsync()
    {
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;

        var errorId = HttpContext?.Request.Query["errorId"].FirstOrDefault();
        if (errorId != null)
        {
            OidcError = await Interaction.GetErrorContextAsync(errorId);
        }
    }
}
